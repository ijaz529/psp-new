# direnv config. Run `direnv allow` once after installing direnv to enable.

# Auto-load .env when entering the repo, so pnpm scripts see the same env as compose.
if [[ -f .env ]]; then
  dotenv .env
fi

# Apps prefer pnpm's local node + bin dir on the PATH.
PATH_add node_modules/.bin

# Local overrides — keep .envrc.local out of git.
if [[ -f .envrc.local ]]; then
  source_env .envrc.local
fi
