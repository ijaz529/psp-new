{
  "name": "@psp-new/issuer-host",
  "version": "0.0.0",
  "private": true,
  "description": "Phase 9. Issuer-host: receives ISO 8583 auth requests from the scheme simulator, applies controls, returns approval/decline. Reverse of acquirer-host.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "echo 'source-only app (tsx)' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@psp-new/db": "workspace:*",
    "@psp-new/errors": "workspace:*",
    "@psp-new/http-server": "workspace:*",
    "@psp-new/ids": "workspace:*",
    "@psp-new/iso8583": "workspace:*",
    "@psp-new/issuing": "workspace:*",
    "@psp-new/ledger": "workspace:*",
    "@psp-new/logger": "workspace:*",
    "@psp-new/otel": "workspace:*",
    "kysely": "^0.27.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "@types/pg": "^8.11.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  }
}
