{
  "name": "@psp-new/vault",
  "version": "0.0.0",
  "private": true,
  "description": "Tokenization vault. Holds the only path to a raw PAN. HMAC dedup + KMS-encrypted PAN at rest.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "echo 'source-only app (tsx)' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@psp-new/db": "workspace:*",
    "@psp-new/errors": "workspace:*",
    "@psp-new/http-server": "workspace:*",
    "@psp-new/ids": "workspace:*",
    "@psp-new/kms": "workspace:*",
    "@psp-new/logger": "workspace:*",
    "@psp-new/otel": "workspace:*",
    "@psp-new/service-auth": "workspace:*",
    "@psp-new/vault-client": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "@types/pg": "^8.11.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  }
}
