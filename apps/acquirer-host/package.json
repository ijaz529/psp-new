{
  "name": "@psp-new/acquirer-host",
  "version": "0.0.0",
  "private": true,
  "description": "ISO 8583 client to the scheme simulator (Phase 5). Phase 0: opens TCP, /healthz, /metrics.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "echo 'source-only app (tsx)' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@psp-new/errors": "workspace:*",
    "@psp-new/http-server": "workspace:*",
    "@psp-new/ids": "workspace:*",
    "@psp-new/iso8583": "workspace:*",
    "@psp-new/logger": "workspace:*",
    "@psp-new/otel": "workspace:*",
    "@psp-new/service-auth": "workspace:*",
    "@psp-new/vault-client": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
