{
  "name": "@psp-new/outbox-relay",
  "version": "0.0.0",
  "private": true,
  "description": "Drains paycore.outbox → enqueues webhook delivery jobs in BullMQ.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "echo 'source-only app (tsx)' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@psp-new/db": "workspace:*",
    "@psp-new/http-server": "workspace:*",
    "@psp-new/logger": "workspace:*",
    "@psp-new/otel": "workspace:*",
    "@psp-new/webhook-delivery": "workspace:*",
    "bullmq": "^5.34.0",
    "fastify": "^5.9.0",
    "ioredis": "^5.4.1",
    "kysely": "^0.27.4"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  }
}
