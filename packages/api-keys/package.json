{
  "name": "@psp-new/api-keys",
  "version": "0.0.0",
  "private": true,
  "description": "API key generation + Fastify auth plugin (publishable + secret keys, sha256-hashed at rest).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "echo 'source-only package' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@psp-new/db": "workspace:*",
    "@psp-new/errors": "workspace:*",
    "@psp-new/ids": "workspace:*",
    "fastify": "^5.9.0",
    "fastify-plugin": "^6.0.0",
    "kysely": "^0.27.4"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  }
}
