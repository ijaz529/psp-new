{
  "name": "@psp-new/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schemas + Kysely runtime + SQL migration runner (advisory-locked).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./kysely": "./src/kysely.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "echo 'source-only package' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "generate": "drizzle-kit generate",
    "migrate": "tsx cli/migrate.ts",
    "reset": "tsx cli/reset.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "kysely": "^0.27.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  }
}
