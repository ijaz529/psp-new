    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
