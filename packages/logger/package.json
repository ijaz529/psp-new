{
  "name": "@psp-new/logger",
  "version": "0.0.0",
  "private": true,
  "description": "PII-redacting structured JSON logger. PAN/CVV/auth headers stripped at the source.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
