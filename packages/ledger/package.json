{
  "name": "@psp-new/ledger",
  "version": "0.0.0",
  "private": true,
  "description": "Double-entry append-only multi-currency ledger. The only writer to ledger.* tables.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "echo 'source-only package' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "balance": "tsx cli/balance.ts"
  },
  "dependencies": {
    "@psp-new/db": "workspace:*",
    "@psp-new/errors": "workspace:*",
    "@psp-new/ids": "workspace:*",
    "@psp-new/money": "workspace:*",
    "kysely": "^0.27.4"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "fast-check": "^3.23.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  }
}
