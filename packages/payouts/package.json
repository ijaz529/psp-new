{
  "name": "@psp-new/payouts",
  "version": "0.0.0",
  "private": true,
  "description": "Merchant payout orchestrator. T+1 nets gross+refunds per (merchant, currency); posts a payout journal entry + inserts paycore.payouts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "echo 'source-only' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@psp-new/db": "workspace:*",
    "@psp-new/errors": "workspace:*",
    "@psp-new/events": "workspace:*",
    "@psp-new/ids": "workspace:*",
    "@psp-new/ledger": "workspace:*",
    "@psp-new/outbox": "workspace:*",
    "kysely": "^0.27.4"
  },
  "devDependencies": {
    "@psp-new/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  }
}
