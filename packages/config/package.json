{
  "name": "@psp-new/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig presets and tooling defaults",
  "type": "module",
  "files": ["tsconfig.lib.json", "tsconfig.app.json", "vitest.config.shared.ts"],
  "exports": {
    "./tsconfig.lib.json": "./tsconfig.lib.json",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./vitest.config.shared": "./vitest.config.shared.ts"
