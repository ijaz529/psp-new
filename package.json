{
  "name": "psp-new",
  "version": "0.0.0",
  "private": true,
  "description": "Strawberry (placeholder name) — Payment Service Provider platform MVP. See PROJECT_BRIEF.md.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rimraf node_modules/.cache .turbo",
    "db:generate": "pnpm --filter @psp-new/db generate",
    "db:migrate": "pnpm --filter @psp-new/db migrate",
    "db:reset": "pnpm --filter @psp-new/db reset",
    "ledger:balance": "pnpm --filter @psp-new/ledger balance",
    "merchant:create": "pnpm --filter @psp-new/api merchant:create --",
    "cardholder:create": "pnpm --filter @psp-new/api cardholder:create --",
    "card:issue": "pnpm --filter @psp-new/api card:issue --",
    "card:load": "pnpm --filter @psp-new/api card:load --",
    "smoke": "node ops/scripts/smoke.mjs",
    "test:browser": "pnpm exec playwright test -c tests/browser/playwright.config.ts",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "lefthook": "^1.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.22.3",
    "turbo": "^2.3.0",
    "typescript": "^6.0.3"
  }
}
