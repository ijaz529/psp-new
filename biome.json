{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      ".next",
      ".turbo",
      "build",
      "coverage",
      "**/migrations/**/*.sql",
      "**/*.generated.ts",
      "**/*.timestamp-*.mjs",
      "ops/compose/grafana/dashboards/**",
      "**/pnpm-lock.yaml"
    ]
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "warn",
        "useNodejsImportProtocol": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noUnusedTemplateLiteral": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noConsole": { "level": "warn", "options": { "allow": ["error", "warn"] } },
        "noExplicitAny": "warn",
        "noThenProperty": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "off"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessConstructor": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "include": ["**/*.test.ts", "**/*.spec.ts", "tests/**", "**/__fixtures__/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noConsole": "off", "noExplicitAny": "off" }
        }
      }
    },
    {
      "include": ["ops/scripts/**", "**/cli/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    }
  ]
}
