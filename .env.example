# =============================================================================
# Strawberry — environment variables (placeholder name; see PROJECT_BRIEF.md)
# Copy to .env for local dev. Never commit .env.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true                    # human-readable logs in dev (Pino-pretty)

# --- Postgres -----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=psp_new
POSTGRES_USER=psp
POSTGRES_PASSWORD=psp_dev_password
# DATABASE_URL = superuser. Used by the migrator (apps/db CLI) and admin tools.
DATABASE_URL=postgres://psp:psp_dev_password@localhost:5432/psp_new
# APP_DATABASE_URL = api / acquirer-host / outbox-relay / worker.
# Has CRUD on paycore.* and ledger.*, ZERO access to vault.*.
APP_DATABASE_URL=postgres://app_user:app_dev_password@localhost:5432/psp_new
# VAULT_DATABASE_URL = vault service ONLY. Has CRUD on vault.*, no access elsewhere.
VAULT_DATABASE_URL=postgres://vault_user:vault_dev_password@localhost:5432/psp_new

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- OpenTelemetry ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=psp-new
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# --- KMS (local dev) ----------------------------------------------------------
# 32-byte master key (base64). Generate with: openssl rand -base64 32
KMS_LOCAL_MASTER_KEY=ZGV2X29ubHlfbm90X2Zvcl9wcm9kdWN0aW9uXzMyYiE=
KMS_PROVIDER=local                 # local | aws

# --- Service-to-service auth (HMAC; mTLS later) -------------------------------
SERVICE_AUTH_SECRET=dev_only_change_me_in_production_minimum_32_chars

# --- Apps: ports --------------------------------------------------------------
API_PORT=8080
VAULT_PORT=8081
ACQUIRER_HOST_PORT=8082
SCHEME_SIMULATOR_TCP_PORT=9001
SCHEME_SIMULATOR_HTTP_PORT=9002
OUTBOX_RELAY_METRICS_PORT=8083
WORKER_METRICS_PORT=8084
PORTAL_PORT=3000

# --- Apps: internal URLs (compose network) ------------------------------------
VAULT_URL=http://vault:8081
ACQUIRER_HOST_URL=http://acquirer-host:8082
SCHEME_SIMULATOR_HOST=scheme-simulator
SCHEME_SIMULATOR_TCP_PORT_INTERNAL=9001

# --- Webhook signing (used Phase 3) -------------------------------------------
WEBHOOK_SIGNING_SECRET=dev_only_change_me_in_production_minimum_32_chars

# --- Idempotency --------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400      # 24h

# --- Stripe-style API key generation (used Phase 3) ---------------------------
API_KEY_ENV=test                   # test | live (live blocked in code unless explicitly set)
